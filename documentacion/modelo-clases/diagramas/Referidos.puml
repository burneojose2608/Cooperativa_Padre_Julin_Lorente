@startuml
title Modelo de análisis propuesto — Referidos
skinparam classAttributeIconSize 0
hide empty members
left to right direction
class ActividadValidada <<Referencia>>
class CambioEstado <<Referencia>>
class Campana <<Referencia>>
class EntradaPadron <<Referencia>>
class Socio <<Referencia>>
class Usuario <<Referencia>>
class CodigoReferido <<Entidad>> {
  - valor: Texto
  - activo: Booleano
  + esValido(): Booleano
  + generarEnlace(base: Texto): Texto
  + generarPara(socio: Socio): CodigoReferido
}
class Prospecto <<Entidad>> {
  - id: Identificador
  - nombres: Texto
  - huellaIdentificacion: Texto [0..1]
  - telefono: Texto [0..1]
  - correo: Texto [0..1]
  - productoInteres: Texto [0..1]
  + coincideCon(persona: Referencia): Booleano
  + tieneContactoUtilizable(): Booleano
}
class ConsentimientoProspecto <<Registro>> {
  - finalidad: Texto
  - versionPolitica: Texto
  - solicitadoEn: FechaHora
  - limiteConfirmacion: FechaHora
  - aceptadoEn: FechaHora [0..1]
  + confirmar(ahora: FechaHora): Booleano
  + estaConfirmado(): Booleano
  + plazoVencido(ahora: FechaHora): Booleano
}
class Referido <<Entidad>> {
  - id: Identificador
  - creadoEn: FechaHora
  - estado: EstadoReferido
  + validarRegistro(): Booleano
  + confirmarConsentimiento(ahora: FechaHora): Booleano
  + iniciarSeguimiento(responsable: Usuario): Booleano
  + rechazar(motivo: Texto, responsable: Usuario): Booleano
  + expirar(ahora: FechaHora): Booleano
  + confirmarConversion(tipo: TipoConversion, evidencia: Texto, responsable: Usuario): Conversion
  + consultarSeguimiento(solicitante: Usuario): DatosSeguimiento
}
class Conversion <<Registro>> {
  - tipo: TipoConversion
  - validadaEn: FechaHora
  - evidenciaPrueba: Texto
  - claveOrigen: Texto
  + esReconocible(): Booleano
}
Socio "1" -- "0..*" CodigoReferido : códigos históricos; como máximo uno activo
CodigoReferido "1" -- "0..*" Referido : código utilizado al registrar
Prospecto "1" -- "0..*" Referido : historial; a lo sumo un referido activo
Referido "1" -- "0..*" ConsentimientoProspecto : solicitudes y evidencia versionada; a lo sumo una confirmación vigente
Referido "1" -- "0..1" Conversion : hecho de conversión; también único por prospecto
Usuario "1" -- "0..*" Conversion : responsable que valida evidencia comercial
Campana "0..1" -- "0..*" Referido : campaña cuando corresponde
Referido ..> EntradaPadron : descarta prospecto ya socio
Referido ..> ActividadValidada : conversión validada produce actividad
Referido ..> CambioEstado : conserva seguimiento
legend bottom
Propuesta de análisis. Ver decisiones y pendientes.
Las referencias externas son los mismos conceptos de otros módulos.
No representa implementación ni importación verificada en EA.
endlegend
@enduml
