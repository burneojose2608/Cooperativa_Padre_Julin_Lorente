# Copia este archivo como ".env" y completa tus datos reales.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=cooperativa_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_HOST=localhost
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dirección de la plataforma web (va dentro del enlace de recuperar contraseña).
# Si compartes un enlace público temporal, pon aquí ese enlace.
FRONTEND_URL=http://localhost:5173

# (Opcional) Correo real. Si no lo llenas, el correo se muestra en la terminal del backend.
